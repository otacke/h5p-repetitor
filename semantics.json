  {
    "name": "behaviour",
    "type": "group",
    "importance": "low",
    "label": "Behavioural settings",
    "fields": [
      {
        "name": "cycle",
        "type": "boolean",
        "label": "Cycle through contents",
        "description": "Go back to first item after last and vice versa.",
        "default": false
      },
      {
        "name": "showProgressOnNavigationDots",
        "type": "boolean",
        "label": "Show progress on navigation dots",
        "description": "If checked, will mark dots of content that was answered.",
        "default": false
      },
      {
        "name": "canGoBackwards",
        "type": "boolean",
        "label": "User can go backwards",
        "description": "If checked, the user can go backwards to a previous question.",
        "default": true
      },
      {
        "name": "canSkipForward",
        "type": "boolean",
        "label": "User can skip forward",
        "description": "If checked, the user can skip forward without answering the current question.",
        "default": true
      },
      {
        "name": "displayPageAnnouncement",
        "type": "boolean",
        "label": "Display current page in toolbar",
        "default": true
      },
      {
        "name": "displayContentAnnouncement",
        "type": "boolean",
        "label": "Display content title in toolbar",
        "default": true
      }
